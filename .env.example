# Local preview is deliberately disabled by default on deployed environments.
APP_MODE=demo
APP_ENV=local
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; needed only for owner-created invitations.
SUPABASE_ADMIN_KEY=
# Messaging secrets belong in Supabase Edge secrets, not NEXT_PUBLIC variables.

# Supabase Edge Function secret: set only after configuring the approved ACS template.
TWILIO_TEMPLATE_VERSION=acs_followup_v1
